{
  "name": "crediflow-bnpl-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "local:db": "node scripts/local-postgres.mjs",
    "local:worker": "tsx scripts/local-worker.ts",
    "db:grants": "tsx scripts/grant-roles.ts",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "db:seed:workflows": "tsx scripts/seed-workflows.ts",
    "db:release": "node scripts/release-migrations.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@vercel/queue": "0.11.0",
    "better-auth": "1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.3",
    "embedded-postgres": "^18.7.0-beta.19",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "effect": "3.22.5",
    "@vercel/queue": {
      "minimatch": "11.0.9"
    },
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
